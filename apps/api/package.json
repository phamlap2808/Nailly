    "drizzle-orm": "^0.43.0",
    "hono": "^4.7.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
